// Cloudflare Workers deploy for the website in web/ (Next.js via OpenNext).
//
// Cloudflare's Git integration builds from the repository root and runs
// `npx wrangler deploy`. Wrangler runs `build.command` first, which installs the
// website's dependencies and turns the Next.js build into a Worker; the paths
// below then point at that output. web/wrangler.jsonc is the same Worker for
// running OpenNext from inside web/ — keep the two in step.
//
// Configuration the site needs at runtime (DATABASE_URL, SUPABASE_URL,
// SUPABASE_SECRET_KEY; see web/.env.example) is set as Worker secrets in the
// Cloudflare dashboard, never here.
{
  "$schema": "web/node_modules/wrangler/config-schema.json",
  "name": "amr-drug-repurposing",
  "main": "web/.open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "web/.open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "cd web && npm ci --no-audit --no-fund && npx opennextjs-cloudflare build"
  },
  "observability": { "enabled": true }
}
