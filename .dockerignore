# Keep the build context to what the worker actually needs.
#
# Two reasons beyond image size. The website must never end up inside this
# image — it is a separate deployment and its presence here would blur the
# boundary. And no secret should ever be reachable from a build context, because
# anything copied into a layer stays in that layer.

# ---------------------------------------------------------------- secrets --
.env
*.env
.env.*
!.env.example
*.pem
*-key.json
.gcp-key.json

# ---------------------------------------------------------------- website --
# The Next.js application is deployed separately and is not part of this image.
web/

# -------------------------------------------------------------- prototype --
# The Streamlit dashboard is the research prototype, not the worker.
app/
.streamlit/

# ------------------------------------------------------------------ bulk ---
# Every model version ever trained is 1.2 GB. Only the four ACTIVE artifacts
# enter the context; the rest never reach the build at all. They are re-included
# by name because an excluded path cannot be COPYed.
models/*
!models/RF-mrsa-v4.joblib
!models/RF-ecoli-v4.joblib
!models/RF-kpneumoniae-v5.joblib
!models/RF-mtb-v5.joblib
# The research database is regenerated by the pipeline and published to
# Supabase; the worker reads Supabase, never a local file.
data/
build/
logs/

# ------------------------------------------------------------ local tools --
.venv/
.tools/
node_modules/
.next/

# ----------------------------------------------------------------- caches --
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------- vcs ---
.git/
.gitignore
.github/

# ---------------------------------------------------------------- noise ----
*.md
!README.md
docs/
tests/
scripts/responsive_qa.py
scripts/performance_qa.py
*.pptx
