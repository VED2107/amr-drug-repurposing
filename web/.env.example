# Website configuration.
#
# Copy to .env.local and fill in. Next reads env from its own root, so this file
# lives here rather than in the Python project. Never commit the filled copy.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Production reads Supabase. Set AMR_DATA_SOURCE=sqlite plus AMR_SQLITE_PATH to
# run the site against the research database directly during development.
AMR_DATA_SOURCE=supabase
# AMR_SQLITE_PATH=C:/PROJECTS/AMR/data/amr.sqlite

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=<service role key>

# Direct Postgres connection, used by the read-only query layer.
DATABASE_URL=postgresql://...
