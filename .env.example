# AMR Drug Repurposing - environment template. Copy to .env and fill in.
# No secrets are required for the default public data sources.

# Optional: contact email sent in the User-Agent to public APIs (good API citizenship).
AMR_CONTACT_EMAIL=

# Optional: override the SQLite database location.
AMR_DB_PATH=

# Optional: absolute path to the AutoDock Vina executable.
AMR_VINA_BIN=

# Optional: set to 1 to forbid all outbound network calls (offline / demo mode).
AMR_OFFLINE=0
